{
  "name": "houselights",
  "version": "1.2.0",
  "description": "A Qloo-grounded slate optimizer with auditable receipts",
  "scripts": {
    "build:worker": "node scripts/build-qloo-worker.mjs",
    "prestart": "npm run build:worker",
    "predev": "npm run build:worker",
    "pretest": "npm run build:worker",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "npm run build:worker && playwright test",
    "probe": "node --env-file-if-exists=.env scripts/probe.mjs",
    "eval": "node --env-file-if-exists=.env scripts/eval.mjs",
    "contingency": "node --env-file-if-exists=.env scripts/contingency.mjs",
    "dossier": "node --env-file-if-exists=.env scripts/dossier.mjs",
    "gm": "node --env-file-if-exists=.env scripts/gm.mjs",
    "venues": "node --env-file-if-exists=.env scripts/venues.mjs",
    "validate:live": "node --env-file-if-exists=.env scripts/validate-live.mjs",
    "validate:festival": "node --env-file-if-exists=.env scripts/validate-festival.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "evaluate:campaign": "node --env-file-if-exists=.env scripts/evaluate-campaign.mjs",
    "evaluate:prepare": "node --env-file-if-exists=.env scripts/prepare-evaluation.mjs",
    "evaluate:offered": "node --env-file-if-exists=.env scripts/prepare-offered-evaluation.mjs",
    "judge:cases": "node --env-file-if-exists=.env scripts/judge-cases.mjs",
    "reproduce:shocks": "node --env-file-if-exists=.env scripts/reproduce-shocks.mjs",
    "reproduce:qloo-proof": "node scripts/reproduce-qloo-proof.mjs",
    "capture:autopilot": "node --env-file-if-exists=.env scripts/capture-autopilot.mjs",
    "reproduce:autopilot": "node scripts/reproduce-autopilot.mjs",
    "build:qloo-contribution": "node scripts/build-qloo-contribution.mjs",
    "build:judge-static": "node scripts/build-judge-static.mjs",
    "evaluate:autopilot": "node scripts/evaluate-autopilot.mjs",
    "evaluate:research-policy": "node scripts/evaluate-research-policy.mjs",
    "capture:workspace-example": "node --env-file-if-exists=.env scripts/capture-workspace-example.mjs",
    "migrate:autopilot-v1": "node scripts/migrate-autopilot-record.mjs",
    "verify:recorded-source": "node scripts/verify-recorded-source.mjs",
    "reproduce:market-coverage": "node scripts/capture-market-coverage.mjs",
    "reproduce:recorded-control": "node scripts/capture-recorded-control.mjs",
    "audit:judge-evaluation": "node scripts/audit-judge-evaluation.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:rehearse": "node scripts/rehearse-release.mjs",
    "import:outcomes": "node scripts/import-demand-outcomes.mjs",
    "financial:demo": "node scripts/generate-financial-demo.mjs",
    "benchmark:financial": "node scripts/benchmark-financial.mjs",
    "deploy:prepare-vercel": "node scripts/prepare-vercel.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "claims:check": "node scripts/claims.mjs --check",
    "claims:update": "node scripts/claims.mjs --update",
    "evaluate:sensitivity": "node scripts/evaluate-sensitivity.mjs",
    "evaluate:rank-vs-optimum": "node scripts/evaluate-rank-vs-optimum.mjs",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@qloo/qloo-harness": "0.1.26",
    "express": "^5.2.1"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.10.2",
      "brace-expansion": "5.0.12"
    }
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@types/node": "22.9.0",
    "esbuild": "0.28.2",
    "typescript": "5.6.3"
  }
}
