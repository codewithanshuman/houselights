# Never commit a real key. Set this as a server secret.
QLOO_API_KEY=
# Event keys may require this explicitly configured host (verified for this project).
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# QLOO_MODE=mock   (synthetic dev data, clearly bannered; never submit in this mode)
CALL_BUDGET=30
INTELLIGENCE_CALL_BUDGET=60
GM_CALL_BUDGET=60
# Required for public/production mode; use an unpredictable secret of 32+ characters.
ORGANIZER_TOKEN=
# PUBLIC_DEMO=1
DAILY_MEMO_CAP=150
# Public plan reservations per UTC day, not the provider's HTTP allowance.
# Keep the current cap until the actual account allowance is confirmed; 0 disables admission.
PUBLIC_PLAN_DAILY_CAP=40
ANTHROPIC_API_KEY=
# Free-tier option: set LLM_PROVIDER=groq and add your Groq key.
GROQ_API_KEY=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=   (set a model ID supported by your Anthropic account)
# LLM_MODE=off   (disable planner/writer/baseline)
# DATA_DIR=./data   (mount a volume in production so share links survive deploys)
# HOST=0.0.0.0   (containers only; local default is 127.0.0.1)
# TRUST_PROXY=1  (only with one trusted reverse proxy)
# JUDGE_CASES_FILE=./deploy/judge-cases.json (seed curated cases once per release)
# PUBLIC_LANDING_PAGE=judge (keep the organizer app at /index.html)
# RELEASE_COMMIT= (deployed Git commit, exposed by /healthz for release verification)
