# Never commit a real key. Set this as a server secret.
QLOO_API_KEY=
# QLOO_MODE=mock   (synthetic dev data, clearly bannered; never submit in this mode)
CALL_BUDGET=30
INTELLIGENCE_CALL_BUDGET=60
GM_CALL_BUDGET=60
DAILY_MEMO_CAP=150
ANTHROPIC_API_KEY=
# LLM_MODEL=   (set a model ID supported by your Anthropic account)
# LLM_MODE=off   (disable planner/writer/baseline)
# DATA_DIR=./data   (mount a volume in production so share links survive deploys)
# HOST=0.0.0.0   (containers only; local default is 127.0.0.1)
# TRUST_PROXY=1  (only with one trusted reverse proxy)
